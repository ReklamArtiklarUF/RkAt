# Kopiera till /etc/reklamartiklar/contact.env på Linux (inte publikt, inte i git).

CONTACT_TO=er@epost.se
CONTACT_FROM=ReklamArtiklar UF <noreply@er-domän.se>

SMTP_HOST=smtp.er-provider.se
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Interna SMTP med egensignerat cert: SMTP_TLS_REJECT_UNAUTHORIZED=false
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# Valfritt (sätts normalt av systemd)
# PORT=3010
# STATIC_ROOT=/opt/reklamartiklar/dist
